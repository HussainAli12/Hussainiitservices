# =============================================================================
# Hussaini IT Services — environment variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your values (get Supabase keys from Project Settings → API)
# 3. Restart the dev server:  pnpm dev
#
# Supabase SQL setup (run once in Supabase → SQL Editor):
#   See supabase/queries/ (01 through 13 in order) or supabase/schema.sql
# =============================================================================

# --- Supabase (required for blog, portfolio, testimonials, contact form) ---
# Project URL — e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe for browser; RLS must protect your tables)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (server-only — never expose to the client or commit to git)
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin panel (/admin) ---
SESSION_SECRET=generate-a-long-random-string-here
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Contact form email (optional — uses Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# --- Analytics (optional — defaults exist in code) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Search Console HTML verification token (the content value only)
# GOOGLE_SITE_VERIFICATION=
# Service account JSON, one line. Give this email Viewer access in GA4 and Search Console.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property ID (Admin → Property settings), not the G- measurement ID
# GA4_PROPERTY_ID=
# Must match the Search Console property name exactly.
# Domain properties use sc-domain:example.com. URL properties include https and a trailing slash.
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:hussainiitservices.com
# Send GA events from localhost (off by default so local traffic does not pollute production)
# NEXT_PUBLIC_GA_DEBUG=true
